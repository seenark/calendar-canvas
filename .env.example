# Copy to .env and fill in. Docker Compose (or `docker run --env-file`) passes it to the app container.

# Origin the app is served from. Used for OAuth redirect URIs and the Origin check.
# Use your public https URL in production. With the Vite dev server use http://localhost:3001.
APP_BASE_URL=http://localhost:8080

# Port the server listens on inside the container.
PORT=8080

# SQLite database file. /data is the compose volume.
DATABASE_PATH=/data/app.db

# Google OAuth client from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 or more random bytes, for example: openssl rand -base64 48
# Signs the short-lived OAuth state cookie.
SESSION_SECRET=

# Admin sign-in. Optional: leave ADMIN_PASSWORD_HASH empty to disable it.
# Generate the hash with: docker compose run --rm -T app hash-password  (password on stdin)
# The hash contains "$" (it looks like $argon2id$v=19$m=65536,t=3,p=2$salt$hash). Never put a plain password here.
# Docker Compose expands "$" in unquoted values, so with Compose paste it between single quotes:
#   ADMIN_PASSWORD_HASH='$argon2id$...'
# `docker run --env-file` keeps quotes as part of the value, so with docker run paste it without quotes:
#   ADMIN_PASSWORD_HASH=$argon2id$...
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Required. Comma-separated Google account emails allowed to sign in, or * for any Google account.
# The server refuses to start when this is empty or missing.
ALLOWED_EMAILS=you@gmail.com
